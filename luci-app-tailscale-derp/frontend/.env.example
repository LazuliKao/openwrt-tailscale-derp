# OpenAI-compatible API Configuration for Translation
OPENAI_API_KEY=your-api-key-here

# Optional: Override the base URL for custom/local providers (DeepSeek, Ollama, LocalAI, etc.)
# Default: https://api.openai.com/v1/chat/completions
# OPENAI_API_URL=https://api.deepseek.com/v1

# Optional: Override the model used (Default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
