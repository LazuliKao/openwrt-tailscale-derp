{
  "luci-app-tailscale-derp": {
    "description": "Grant UCI and ubus access to DERP relay manager",
    "read": {
      "ubus": {
        "luci.tailscale-derp": [
          "get_status",
          "get_version",
          "get_clients",
          "get_peers"
        ]
      },
      "uci": [
        "tailscale-derp"
      ]
    },
    "write": {
      "ubus": {
        "luci.tailscale-derp": [
          "start",
          "stop",
          "restart",
          "reload_config"
        ]
      },
      "uci": [
        "tailscale-derp"
      ]
    }
  }
}
