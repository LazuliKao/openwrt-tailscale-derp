config settings 'global'
    option enabled '1'
	option listen ':3478'
	option stun '1'

config tls 'tls'
	option certfile ''
	option keyfile ''

config external 'external'
	option enabled '0'
	list method 'pcp'
	list method 'natpmp'
	list method 'upnp'
	option wan_interface 'auto'
	option derp_port 'auto'
	option stun_port 'auto'
	option lease_seconds '7200'
	option retry_seconds '60'
	option sync_interval '300'
	option validate_endpoint '0'

config mesh 'mesh'
	option enabled '0'
	option key ''

config ops 'ops'
    option socket '/var/run/tailscale-derp/ops.sock'
	option health ':9912'

config traffic 'traffic'
	option persist '0'
	option path '/tmp/tailscale-derp-traffic.json'
	option interval '60'

config verify 'verify'
	option enabled '0'
	option url_enabled '0'
	option tailscaled_enabled '0'
	option tailscaled_socket_enabled '0'
	option tailscaled_socket ''
	option api_enabled '0'
	option sync_interval '300'
	option cache_ttl '900'
	list url ''
