{
  "luci-app-tailscale-derp": {
    "description": "Grant UCI and ubus access to DERP relay manager",
    "read": {
      "ubus": {
        "luci.tailscale-derp": [
          "get_status",
          "get_external_status",
          "get_version",
          "get_clients",
          "get_peers",
          "get_devices",
          "get_tailnets",
          "get_tailnet_acl",
          "get_device_routes",
          "get_device_attributes"
        ]
      },
      "uci": [
        "tailscale-derp"
      ]
    },
    "write": {
      "ubus": {
        "luci.tailscale-derp": [
          "start",
          "stop",
          "restart",
          "reload_config",
          "reconcile_external",
          "check_external",
          "sync_derpmap",
          "refresh_devices",
          "set_device_ipv4",
          "set_device_authorized",
          "set_device_name",
          "set_device_tags",
          "set_device_key",
          "delete_device",
          "set_device_routes",
          "set_device_attribute",
          "delete_device_attribute",
          "expire_device",
          "validate_tailnet_acl",
          "set_tailnet_acl"
        ]
      },
      "uci": [
        "tailscale-derp"
      ]
    }
  }
}
