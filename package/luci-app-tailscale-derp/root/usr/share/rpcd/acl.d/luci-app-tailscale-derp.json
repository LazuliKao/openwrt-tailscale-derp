{
  "luci-app-tailscale-derp": {
    "description": "Grant UCI and ubus access to DERP relay manager",
    "read": {
      "ubus": {
        "luci.tailscale-derp": [
          "get_status",
          "get_version",
          "get_clients",
          "get_peers",
          "get_devices",
          "get_tailnets",
          "get_tailnet_acl"
        ]
      },
      "uci": [
        "tailscale-derp"
      ]
    },
    "write": {
      "ubus": {
        "luci.tailscale-derp": [
          "start",
          "stop",
          "restart",
          "reload_config",
          "refresh_devices",
          "set_api_key",
          "set_device_ipv4",
          "validate_tailnet_acl",
          "set_tailnet_acl"
        ]
      },
      "uci": [
        "tailscale-derp"
      ]
    }
  }
}
