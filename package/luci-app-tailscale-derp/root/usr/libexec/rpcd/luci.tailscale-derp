#!/bin/sh

. /usr/share/libubox/jshn.sh

CONFIG_NAME=tailscale-derp
SECRET_CONFIG_NAME=tailscale-derp-secrets
SECRET_FILE=/etc/config/tailscale-derp-secrets
DEFAULT_OPS_ADDR=127.0.0.1:9911
SERVICE_SCRIPT=/etc/init.d/tailscale-derp

is_loopback_ops_addr() {
    case "$1" in
        127.0.0.1:[0-9]*|localhost:[0-9]*|\[::1\]:[0-9]*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

ops_addr() {
    local configured

    configured="$(uci -q get ${CONFIG_NAME}.ops.metrics)"
    [ -n "$configured" ] || configured="$DEFAULT_OPS_ADDR"

    is_loopback_ops_addr "$configured" || configured="$DEFAULT_OPS_ADDR"

    case "$configured" in
        :*)
            echo "http://127.0.0.1${configured}"
            ;;
        *)
            echo "http://${configured}"
            ;;
    esac
}

service_action() {
    local action="$1"
    local output

    output="$($SERVICE_SCRIPT "$action" 2>&1)" || {
        output="$(printf '%s' "$output" | sed 's/"/\\"/g')"
        [ -n "$output" ] || output="service action failed"
        echo "{\"action\":\"${action}\",\"result\":\"error\",\"error\":\"${output}\"}"
        return 1
    }

    echo "{\"action\":\"${action}\",\"result\":\"ok\"}"
}

fetch_json() {
    local url="$1"
    local method="${2:-GET}"

    if [ "$method" = "POST" ]; then
        wget -q -O - --post-data='' "$url" 2>/dev/null || {
            echo '{"error":"backend unavailable"}'
            return 1
        }
        return 0
    fi

    wget -q -O - "$url" 2>/dev/null || {
        echo '{"error":"backend unavailable"}'
        return 1
    }
}

set_api_key() {
    local payload name api_key clear

    payload="$(cat)"
    [ -n "$payload" ] || payload='{}'
    json_cleanup
    json_load "$payload" 2>/dev/null || {
        echo '{"error":"invalid RPC parameters"}'
        return 1
    }
    json_get_var name name
    json_get_var api_key api_key
    json_get_var clear clear

    case "$name" in
        ''|*[!A-Za-z0-9_]*|.*)
            echo '{"error":"invalid API instance name"}'
            return 1
            ;;
    esac

    case "$api_key" in
        *[![:print:]]*)
            echo '{"error":"invalid API key"}'
            return 1
            ;;
    esac

    if [ "$clear" = "1" ]; then
        [ -e "$SECRET_FILE" ] || {
            echo '{"result":"ok"}'
            return 0
        }
        uci -q delete "${SECRET_CONFIG_NAME}.${name}" 2>/dev/null || true
    else
        [ -n "$api_key" ] || {
            echo '{"error":"API key is required"}'
            return 1
        }
        umask 077
        [ -e "$SECRET_FILE" ] || : > "$SECRET_FILE" || {
            echo '{"error":"cannot create API secrets file"}'
            return 1
        }
        chmod 600 "$SECRET_FILE" 2>/dev/null || {
            echo '{"error":"cannot protect API secrets file"}'
            return 1
        }
        uci -q set "${SECRET_CONFIG_NAME}.${name}=secret" 2>/dev/null || {
            echo '{"error":"cannot update API secret"}'
            return 1
        }
        uci -q set "${SECRET_CONFIG_NAME}.${name}.api_key=${api_key}" 2>/dev/null || {
            echo '{"error":"cannot update API secret"}'
            return 1
        }
    fi

    uci -q commit "$SECRET_CONFIG_NAME" 2>/dev/null || {
        echo '{"error":"cannot commit API secret"}'
        return 1
    }
    [ -e "$SECRET_FILE" ] && chmod 600 "$SECRET_FILE" 2>/dev/null
    echo '{"result":"ok"}'
}

rpc_read() {
    local base_url
    base_url="$(ops_addr)"

    case "$1" in
        get_status)
            fetch_json "${base_url}/status"
            ;;
        get_version)
            fetch_json "${base_url}/version"
            ;;
        get_clients)
            fetch_json "${base_url}/clients"
            ;;
        get_peers)
            fetch_json "${base_url}/peers"
            ;;
        get_devices)
            fetch_json "${base_url}/devices"
            ;;
        *)
            echo '{"error":"unknown method"}'
            exit 1
            ;;
    esac
}

rpc_write() {
    local base_url
    base_url="$(ops_addr)"

    case "$1" in
        start)
            service_action start
            ;;
        stop)
            service_action stop
            ;;
        restart)
            service_action restart
            ;;
        reload_config)
            service_action reload
            ;;
        refresh_devices)
            fetch_json "${base_url}/devices/refresh" POST
            ;;
        set_api_key)
            set_api_key
            ;;
        *)
            echo '{"error":"unknown method"}'
            exit 1
            ;;
    esac
}

case "$1" in
    list)
        echo '{"get_status":{},"get_version":{},"get_clients":{},"get_peers":{},"get_devices":{},"start":{},"stop":{},"restart":{},"reload_config":{},"refresh_devices":{},"set_api_key":{"name":"String","api_key":"String","clear":"String"}}'
        ;;
    call)
        method="$2"
        case "$method" in
            get_status|get_version|get_clients|get_peers|get_devices)
                rpc_read "$method"
                ;;
            start|stop|restart|reload_config|refresh_devices|set_api_key)
                rpc_write "$method"
                ;;
            *)
                echo '{"error":"unknown method"}'
                exit 1
                ;;
        esac
        ;;
    *)
        echo '{"error":"unknown command"}'
        exit 1
        ;;
esac
