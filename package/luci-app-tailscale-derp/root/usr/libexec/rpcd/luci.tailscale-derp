#!/bin/sh

. /usr/share/libubox/jshn.sh

CONFIG_NAME=tailscale-derp
DEFAULT_OPS_ADDR=127.0.0.1:9911
SERVICE_SCRIPT=/etc/init.d/tailscale-derp

is_loopback_ops_addr() {
    case "$1" in
        127.0.0.1:[0-9]*|localhost:[0-9]*|\[::1\]:[0-9]*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

ops_addr() {
    local configured

    configured="$(uci -q get ${CONFIG_NAME}.ops.metrics)"
    [ -n "$configured" ] || configured="$DEFAULT_OPS_ADDR"

    is_loopback_ops_addr "$configured" || configured="$DEFAULT_OPS_ADDR"

    case "$configured" in
        :*)
            echo "http://127.0.0.1${configured}"
            ;;
        *)
            echo "http://${configured}"
            ;;
    esac
}

service_action() {
    local action="$1"
    local output

    output="$($SERVICE_SCRIPT "$action" 2>&1)" || {
        output="$(printf '%s' "$output" | sed 's/"/\\"/g')"
        [ -n "$output" ] || output="service action failed"
        echo "{\"action\":\"${action}\",\"result\":\"error\",\"error\":\"${output}\"}"
        return 1
    }

    echo "{\"action\":\"${action}\",\"result\":\"ok\"}"
}

json_error() {
    json_init
    json_add_string error "$1"
    json_dump
}

request_json() {
    local url="$1"
    local method="$2"
    local body_file="$3"
    local output_file="$4"

    case "$method" in
        GET)
            uclient-fetch -q -O "$output_file" --no-proxy --timeout=10 "$url" 2>/dev/null
            ;;
        POST|PUT|DELETE)
            if [ -n "$body_file" ]; then
                uclient-fetch -q -O "$output_file" --no-proxy --timeout=10 \
                    --method="$method" --body-file="$body_file" \
                    --header='Content-Type: application/json' "$url" 2>/dev/null
            else
                uclient-fetch -q -O "$output_file" --no-proxy --timeout=10 \
                    --method="$method" "$url" 2>/dev/null
            fi
            ;;
        *)
            return 1
            ;;
    esac
}

fetch_json() {
    local output_file rc

    output_file="$(mktemp /tmp/tailscale-derp-rpc.XXXXXX)" || {
        json_error "cannot create temporary response file"
        return 1
    }
    request_json "$1" "${2:-GET}" "$3" "$output_file"
    rc=$?
    if [ "$rc" -eq 0 ]; then
        cat "$output_file"
    else
        json_error "backend request failed"
    fi
    rm -f "$output_file"
    return "$rc"
}

read_params() {
    local input_file payload bytes

    input_file="$(mktemp /tmp/tailscale-derp-rpc.XXXXXX)" || return 1
    cat > "$input_file"
    bytes="$(wc -c < "$input_file")"
    if [ "$bytes" -gt 4194304 ]; then
        rm -f "$input_file"
        json_error "request is too large"
        return 1
    fi
    payload="$(cat "$input_file")"
    rm -f "$input_file"

    json_cleanup
    json_load "$payload" 2>/dev/null || {
        json_error "invalid RPC parameters"
        return 1
    }
}

valid_instance_name() {
    case "$1" in
        ''|*[!A-Za-z0-9_]*|.*)
            return 1
            ;;
    esac
    return 0
}

valid_device_id() {
    case "$1" in
        ''|*[!A-Za-z0-9_-]*)
            return 1
            ;;
    esac
    return 0
}

get_tailnet_acl() {
    local base_url instance

    read_params || return 1
    json_get_var instance instance
    valid_instance_name "$instance" || {
        json_error "invalid API instance name"
        return 1
    }
    base_url="$(ops_addr)"
    fetch_json "${base_url}/tailnets/${instance}/acl"
}

set_device_ipv4() {
    local base_url instance device_id ipv4 body_file

    read_params || return 1
    json_get_var instance instance
    json_get_var device_id device_id
    json_get_var ipv4 ipv4
    valid_instance_name "$instance" || {
        json_error "invalid API instance name"
        return 1
    }
    valid_device_id "$device_id" || {
        json_error "invalid device ID"
        return 1
    }
    [ -n "$ipv4" ] || {
        json_error "IPv4 address is required"
        return 1
    }

    body_file="$(mktemp /tmp/tailscale-derp-rpc.XXXXXX)" || {
        json_error "cannot create temporary request file"
        return 1
    }
    json_init
    json_add_string ipv4 "$ipv4"
    json_dump > "$body_file"
    base_url="$(ops_addr)"
    fetch_json "${base_url}/tailnets/${instance}/devices/${device_id}/ip" PUT "$body_file"
    local rc=$?
    rm -f "$body_file"
    return "$rc"
}

device_request_params() {
    json_get_var instance instance
    json_get_var device_id device_id
    valid_instance_name "$instance" || {
        json_error "invalid API instance name"
        return 1
    }
    valid_device_id "$device_id" || {
        json_error "invalid device ID"
        return 1
    }
}

device_request() {
    local endpoint="$1"
    local method="$2"
    local body_file="$3"
    local base_url rc

    base_url="$(ops_addr)"
    fetch_json "${base_url}/tailnets/${instance}/devices/${device_id}${endpoint}" "$method" "$body_file"
    rc=$?
    [ -z "$body_file" ] || rm -f "$body_file"
    return "$rc"
}

new_device_body() {
    body_file="$(mktemp /tmp/tailscale-derp-rpc.XXXXXX)" || {
        json_error "cannot create temporary request file"
        return 1
    }
}

set_device_authorized() {
    local instance device_id authorized body_file

    read_params || return 1
    device_request_params || return 1
    json_get_var authorized authorized
    new_device_body || return 1
    json_init
    json_add_boolean authorized "$authorized"
    json_dump > "$body_file"
    device_request "/authorized" PUT "$body_file"
}

set_device_name() {
    local instance device_id name body_file

    read_params || return 1
    device_request_params || return 1
    json_get_var name name
    [ -n "$name" ] || {
        json_error "device name is required"
        return 1
    }
    new_device_body || return 1
    json_init
    json_add_string name "$name"
    json_dump > "$body_file"
    device_request "/name" PUT "$body_file"
}

set_device_tags() {
    local instance device_id tags body_file tag

    read_params || return 1
    device_request_params || return 1
    json_get_values tags tags
    new_device_body || return 1
    json_init
    json_add_array tags
    for tag in $tags; do
        json_add_string '' "$tag"
    done
    json_close_array
    json_dump > "$body_file"
    device_request "/tags" PUT "$body_file"
}

set_device_key() {
    local instance device_id key_expiry_disabled body_file

    read_params || return 1
    device_request_params || return 1
    json_get_var key_expiry_disabled key_expiry_disabled
    new_device_body || return 1
    json_init
    json_add_boolean keyExpiryDisabled "$key_expiry_disabled"
    json_dump > "$body_file"
    device_request "/key" PUT "$body_file"
}

delete_device() {
    local instance device_id

    read_params || return 1
    device_request_params || return 1
    device_request '' DELETE ''
}

get_device_routes() {
    local instance device_id

    read_params || return 1
    device_request_params || return 1
    device_request "/routes" GET ''
}

set_device_routes() {
    local instance device_id routes body_file route

    read_params || return 1
    device_request_params || return 1
    json_get_values routes routes
    new_device_body || return 1
    json_init
    json_add_array routes
    for route in $routes; do
        json_add_string '' "$route"
    done
    json_close_array
    json_dump > "$body_file"
    device_request "/routes" PUT "$body_file"
}

get_device_attributes() {
    local instance device_id

    read_params || return 1
    device_request_params || return 1
    device_request "/attributes" GET ''
}

set_device_attribute() {
    local instance device_id key value expiry comment body_file

    read_params || return 1
    device_request_params || return 1
    json_get_var key key
    json_get_var value value
    json_get_var expiry expiry
    json_get_var comment comment
    [ -n "$key" ] && [ -n "$value" ] && [ -n "$expiry" ] || {
        json_error "attribute key, value, and expiry are required"
        return 1
    }
    new_device_body || return 1
    json_init
    json_add_string key "$key"
    json_add_string value "$value"
    json_add_string expiry "$expiry"
    json_add_string comment "$comment"
    json_dump > "$body_file"
    device_request "/attributes" POST "$body_file"
}

delete_device_attribute() {
    local instance device_id key body_file

    read_params || return 1
    device_request_params || return 1
    json_get_var key key
    [ -n "$key" ] || {
        json_error "attribute key is required"
        return 1
    }
    new_device_body || return 1
    json_init
    json_add_string key "$key"
    json_dump > "$body_file"
    device_request "/attributes" DELETE "$body_file"
}

expire_device() {
    local instance device_id

    read_params || return 1
    device_request_params || return 1
    device_request "/expire" POST ''
}

validate_tailnet_acl() {
    local base_url instance hujson body_file

    read_params || return 1
    json_get_var instance instance
    json_get_var hujson hujson
    valid_instance_name "$instance" || {
        json_error "invalid API instance name"
        return 1
    }
    [ -n "$hujson" ] || {
        json_error "ACL policy is required"
        return 1
    }

    body_file="$(mktemp /tmp/tailscale-derp-rpc.XXXXXX)" || {
        json_error "cannot create temporary request file"
        return 1
    }
    json_init
    json_add_string hujson "$hujson"
    json_dump > "$body_file"
    base_url="$(ops_addr)"
    fetch_json "${base_url}/tailnets/${instance}/acl/validate" POST "$body_file"
    local rc=$?
    rm -f "$body_file"
    return "$rc"
}

set_tailnet_acl() {
    local base_url instance hujson etag body_file current_file current_etag rc

    read_params || return 1
    json_get_var instance instance
    json_get_var hujson hujson
    json_get_var etag etag
    valid_instance_name "$instance" || {
        json_error "invalid API instance name"
        return 1
    }
    [ -n "$hujson" ] || {
        json_error "ACL policy is required"
        return 1
    }
    [ -n "$etag" ] || {
        json_error "ACL ETag is required"
        return 1
    }

    body_file="$(mktemp /tmp/tailscale-derp-rpc.XXXXXX)" || {
        json_error "cannot create temporary request file"
        return 1
    }
    json_init
    json_add_string hujson "$hujson"
    json_add_string etag "$etag"
    json_dump > "$body_file"
    base_url="$(ops_addr)"

    current_file="$(mktemp /tmp/tailscale-derp-rpc.XXXXXX)" || {
        rm -f "$body_file"
        json_error "cannot create temporary response file"
        return 1
    }
    request_json "${base_url}/tailnets/${instance}/acl" PUT "$body_file" "$current_file"
    rc=$?
    if [ "$rc" -eq 0 ]; then
        cat "$current_file"
    elif [ "$rc" -eq 8 ] && request_json "${base_url}/tailnets/${instance}/acl" GET '' "$current_file"; then
        # uclient-fetch uses exit code 8 for all HTTP errors, so an ETag change identifies a conflict.
        json_cleanup
        if json_load "$(cat "$current_file")" 2>/dev/null; then
            json_get_var current_etag etag
        fi
        if [ -n "$current_etag" ] && [ "$current_etag" != "$etag" ]; then
            json_init
            json_add_string error "ACL policy changed on the server"
            json_add_boolean conflict 1
            json_add_string etag "$current_etag"
            json_dump
            rc=0
        else
            json_error "backend request failed"
        fi
    else
        json_error "backend request failed"
    fi
    rm -f "$body_file" "$current_file"
    return "$rc"
}



rpc_read() {
    local base_url
    base_url="$(ops_addr)"

    case "$1" in
        get_status)
            fetch_json "${base_url}/status"
            ;;
        get_version)
            fetch_json "${base_url}/version"
            ;;
        get_clients)
            fetch_json "${base_url}/clients"
            ;;
        get_peers)
            fetch_json "${base_url}/peers"
            ;;
        get_devices)
            fetch_json "${base_url}/devices"
            ;;
        get_tailnets)
            fetch_json "${base_url}/tailnets"
            ;;
        get_tailnet_acl)
            get_tailnet_acl
            ;;
        get_device_routes)
            get_device_routes
            ;;
        get_device_attributes)
            get_device_attributes
            ;;
        *)
            echo '{"error":"unknown method"}'
            exit 1
            ;;
    esac
}

rpc_write() {
    local base_url
    base_url="$(ops_addr)"

    case "$1" in
        start)
            service_action start
            ;;
        stop)
            service_action stop
            ;;
        restart)
            service_action restart
            ;;
        reload_config)
            service_action reload
            ;;
        refresh_devices)
            fetch_json "${base_url}/devices/refresh" POST ''
            ;;
        set_device_ipv4)
            set_device_ipv4
            ;;
        set_device_authorized)
            set_device_authorized
            ;;
        set_device_name)
            set_device_name
            ;;
        set_device_tags)
            set_device_tags
            ;;
        set_device_key)
            set_device_key
            ;;
        delete_device)
            delete_device
            ;;
        set_device_routes)
            set_device_routes
            ;;
        set_device_attribute)
            set_device_attribute
            ;;
        delete_device_attribute)
            delete_device_attribute
            ;;
        expire_device)
            expire_device
            ;;
        validate_tailnet_acl)
            validate_tailnet_acl
            ;;
        set_tailnet_acl)
            set_tailnet_acl
            ;;
        *)
            echo '{"error":"unknown method"}'
            exit 1
            ;;
    esac
}

case "$1" in
    list)
        echo '{"get_status":{},"get_version":{},"get_clients":{},"get_peers":{},"get_devices":{},"get_tailnets":{},"get_tailnet_acl":{"instance":"String"},"get_device_routes":{"instance":"String","device_id":"String"},"get_device_attributes":{"instance":"String","device_id":"String"},"start":{},"stop":{},"restart":{},"reload_config":{},"set_device_ipv4":{"instance":"String","device_id":"String","ipv4":"String"},"set_device_authorized":{"instance":"String","device_id":"String","authorized":"Boolean"},"set_device_name":{"instance":"String","device_id":"String","name":"String"},"set_device_tags":{"instance":"String","device_id":"String","tags":"Array"},"set_device_key":{"instance":"String","device_id":"String","key_expiry_disabled":"Boolean"},"delete_device":{"instance":"String","device_id":"String"},"set_device_routes":{"instance":"String","device_id":"String","routes":"Array"},"set_device_attribute":{"instance":"String","device_id":"String","key":"String","value":"String","expiry":"String","comment":"String"},"delete_device_attribute":{"instance":"String","device_id":"String","key":"String"},"expire_device":{"instance":"String","device_id":"String"},"validate_tailnet_acl":{"instance":"String","hujson":"String"},"set_tailnet_acl":{"instance":"String","hujson":"String","etag":"String"}}'
        ;;
    call)
        method="$2"
        case "$method" in
            get_status|get_version|get_clients|get_peers|get_devices|get_tailnets|get_tailnet_acl|get_device_routes|get_device_attributes)
                rpc_read "$method"
                ;;
            start|stop|restart|reload_config|refresh_devices|set_device_ipv4|set_device_authorized|set_device_name|set_device_tags|set_device_key|delete_device|set_device_routes|set_device_attribute|delete_device_attribute|expire_device|validate_tailnet_acl|set_tailnet_acl)
                rpc_write "$method"
                ;;
            *)
                echo '{"error":"unknown method"}'
                exit 1
                ;;
        esac
        ;;
    *)
        echo '{"error":"unknown command"}'
        exit 1
        ;;
esac
