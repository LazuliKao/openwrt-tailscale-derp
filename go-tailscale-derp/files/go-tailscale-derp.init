#!/bin/sh /etc/rc.common

START=99
STOP=01

USE_PROCD=1

PROG=/usr/bin/go-tailscale-derp
CONFIG_FILE=/etc/config/go-tailscale-derp

append_mesh_peer() {
    local peer="$1"

    [ -n "$peer" ] || return 0

    if [ -n "$peers_csv" ]; then
        peers_csv="${peers_csv},${peer}"
    else
        peers_csv="$peer"
    fi
}

start_service() {
    local enabled listen stun certfile keyfile mesh metrics health peers_csv

    config_load go-tailscale-derp

    config_get enabled global enabled '0'
    [ "$enabled" = "1" ] || return 0

    config_get listen global listen ':3478'
    config_get stun global stun '1'
    config_get certfile tls certfile ''
    config_get keyfile tls keyfile ''
    config_get mesh mesh enabled '0'
    config_get metrics ops metrics ':9911'
    config_get health ops health ':9912'

    procd_open_instance
    procd_set_param command "$PROG"
    procd_append_param command --listen "$listen"

    [ "$stun" = "1" ] && procd_append_param command --stun

    if [ -n "$certfile" ] && [ -n "$keyfile" ]; then
        procd_append_param command --certfile "$certfile"
        procd_append_param command --keyfile "$keyfile"
    fi

    if [ "$mesh" = "1" ]; then
        procd_append_param command --mesh
        config_list_foreach mesh peers append_mesh_peer
        [ -n "$peers_csv" ] && procd_append_param command --peers "$peers_csv"
    fi

    procd_append_param command --ops "$metrics"
    procd_append_param command --health "$health"

    procd_set_param file "$CONFIG_FILE"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "go-tailscale-derp"
}
